[Unit]
Description=dnshived cluster daemon (controller)
After=network-online.target dnshived-helper.service
Wants=network-online.target
Requires=dnshived-helper.service

[Service]
Type=simple
ExecStart=/usr/local/bin/dnshived --config /etc/dnshived/cluster.json
# Closes this node's DHCP gates on every stop (clean, crash or restart),
# so a dead daemon never leaves a gate open. A restarted daemon reopens
# only after earning STABLE again. "+" runs it as root so the direct
# nftables fallback works when the helper is down.
ExecStopPost=+/usr/local/bin/dnshived --config /etc/dnshived/cluster.json --emergency-close-gates
# Bounds a hung emergency close.
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# Unprivileged: everything privileged goes through dnshived-helper. The
# one capability serves bootstrap mode's setup wizard on :80/:443.
User=dnshived
Group=dnshived
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
