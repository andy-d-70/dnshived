[Unit]
Description=dnshived probe host (external DHCP/DNS validation)
After=network-online.target
Wants=network-online.target
# Start limit: a persistent failure stops after 10 attempts in 5 minutes
# instead of restarting forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/dnshived-probe --config /etc/dnshived/probe.json
Restart=on-failure
RestartSec=2
User=dnshived
StateDirectory=dnshived-probe
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# CAP_NET_BIND_SERVICE: binding the DHCP client port (:68) as non-root.
# SO_BINDTODEVICE on the scope VLAN interface needs no capability
# (Linux >= 5.7).
# StateDirectory: /var/lib/dnshived-probe is always writable.

[Install]
WantedBy=multi-user.target
